# Copy to .env and uncomment what you need. Every variable is optional; defaults shown.
# Variables already set in the environment take precedence.

# PORT=33001
# LOG_LEVEL=info

# Paths; the defaults are files in the data/ folder next to src/ (/app/data in Docker)
# DB_PATH=
# CONFIG_PATH=   (legacy accounts.json, only read once to import it into the database)
# RULES_PATH=

# Steam
# STEAM_APP_ID=730
# STEAM_CURRENCY=2
# PRICE_RATE_LIMIT_MS=1100
# INVENTORY_RATE_LIMIT_MS=3000
# RATE_LIMIT_RETRY_MS=60000

# Scheduling
# REENQUEUE_DELAY_MS=21600000
# SEVEN_DAYS_SECS=604800
# WORKER_IDLE_SLEEP_MS=500
# QUEUE_WARN_SIZE=50

# Account limits
# MAX_STEAM64IDS=10
# MAX_CUSTOM_ITEMS=50
